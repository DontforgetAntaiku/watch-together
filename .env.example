# Host port the backend is published on (127.0.0.1 only; the host nginx proxies /api/ to it)
BACKEND_PORT=8000
# True = /docs and debug output on. Set False in production.
BACKEND_DEBUG=True
# False builds the frontend for production (no debug logging)
FRONTEND_DEBUG=True
# Public address of the site, e.g. https://watch.example.com (link previews in Telegram, Discord ... need it)
SITE_URL=
# Where the built static site is copied (read by scripts/sub_deploy.sh)
FRONTEND_BUILD_OUTPUT=./deploy
# Comma-separated site origins allowed to call the API (empty = any; set it in production)
ALLOWED_ORIGINS=
# Limits (defaults shown)
MAX_ROOMS=5000
MAX_MEMBERS=30
EMPTY_ROOM_TTL=1800
CREATE_PER_MINUTE=20

# Optional "resolve a page link" lookup with yt-dlp. OFF by default; read the README section first (security).
RESOLVER_ENABLED=false
# Only these sites (and their subdomains), comma-separated. Empty = any public site.
RESOLVER_ALLOWED_HOSTS=
RESOLVER_TIMEOUT=25
RESOLVER_MAX_CONCURRENT=2
RESOLVER_PER_MINUTE=6
# Route yt-dlp through an egress proxy that cannot reach your private networks, e.g. http://proxy:3128
RESOLVER_PROXY=
RESOLVER_CACHE_TTL=600
